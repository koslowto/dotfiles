#Needed for cursor settings to work
shell_integration 	    no-cursor

#Font settings
font_family 		    JetBrainsMono Nerd Font Mono
bold_font 		        auto
italic_font 		    auto
bold_italic_font 	    auto
font_size 		        16.0

#Colorscheme
foreground		        #cdd6f4
background 		        #1e1e2e
selection_foreground 	#1e1e2e
selection_background 	#a6adc8

#General functionality
modify_font		        cell_height 105%
scrollback_lines 	    2000
enable_audio_bell 	    no

#Cursor settings
cursor			        #f38ba8
cursor_text_color 	    #1e1e2e
cursor_shape 		    beam
cursor_blink_interval 	-1

#Custom key mappings
map 			        ctrl+t new_tab
map 			        ctrl+w close_tab

#Tab bar settings
tab_bar_edge 		    top
tab_bar_min_tabs 	    1
tab_bar_style 		    powerline
tab_powerline_style 	slanted
tab_bar_margin_width 	0.0
tab_bar_align 		    left
tab_switch_strategy 	left

#Tab display settings
tab_title_template 	"{title}"
active_tab_foreground   #1e1e2e
active_tab_background   #cba6f7
active_tab_font_style   bold-italic
inactive_tab_foreground #585b70
inactive_tab_background #b4befe
inactive_tab_font_style italic

#Window settings
enabled_layouts 	Tall, *
draw_minimal_borders 	yes
window_margin_width 	0
window_padding_width 	0
hide_window_decorations yes

#Url display settings
url_color 		#0087bd
url_style 		curly

# Terminal Colors

# Black
color0 			#1e1e2e
color8 			#1e1e2e

# Red
color1 			#f38ba8
color9 			#f38ba8

# Green
color2  		#94e2d5
color10 		#94e2d5

# Yellow
color3  		#f9e2af
color11 		#f9e2af

# Blue
color4			#89b4fa
color12			#89b4fa

# Magenta
color5  		#cba6f7
color13 		#cba6f7

# Cyan
color6  		#f2cdcd
color14 		#f2cdcd

# White
color7  		#cdd6f4
color15 		#cdd6f4

# Why does this not fit nicely :(((
cursor_stop_blinking_after -1
